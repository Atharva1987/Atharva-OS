        // RENDER ARTICLES
        function renderArticles(filter = 'all') {
            const listContainer = document.getElementById('articlesList');
            listContainer.innerHTML = '';

            const filtered = filter === 'all' ? posts : posts.filter(p => p.tag === filter);

            if (filtered.length === 0) {
                listContainer.innerHTML = `<p class="py-8 font-mono text-xs text-brand-500">No articles found in this category.</p>`;
                return;
            }

            filtered.forEach(post => {
                const item = document.createElement('article');
                item.className = 'py-6 group cursor-pointer hover:bg-brand-100/40 dark:hover:bg-brand-900/30 px-3 rounded-lg transition-colors';
                item.onclick = () => openArticleModal(post.id);

                item.innerHTML = `
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 mb-2">
                        <div class="flex items-center gap-3">
                            <span class="mono-tag font-mono font-medium text-blue-600 dark:text-blue-400">${post.tag}</span>
                            <span class="text-brand-300 dark:text-brand-700 text-xs">•</span>
                            <span class="text-xs font-mono text-brand-500 dark:text-brand-400">${post.date}</span>
                        </div>
                        <span class="text-xs font-mono text-brand-500 dark:text-brand-400">${post.readTime}</span>
                    </div>
                    <h3 class="text-lg font-semibold text-brand-900 dark:text-brand-50 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">${post.title}</h3>
                    <p class="text-xs sm:text-sm text-brand-600 dark:text-brand-400 mt-2 line-clamp-2 leading-relaxed">${post.abstract}</p>
                `;

                listContainer.appendChild(item);
            });
        }

        // FILTER ARTICLES
        function filterPosts(tag) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.dataset.tag === tag) {
                    btn.className = 'filter-btn px-3 py-1 rounded-md border border-brand-300 dark:border-brand-700 bg-brand-200 dark:bg-brand-800 text-brand-900 dark:text-brand-100 transition-colors';
                } else {
                    btn.className = 'filter-btn px-3 py-1 rounded-md border border-brand-200 dark:border-brand-800/80 bg-brand-100/40 dark:bg-brand-900/40 text-brand-600 dark:text-brand-400 hover:text-brand-900 dark:hover:text-brand-100 transition-colors';
                }
            });
            renderArticles(tag);
        }

        // ARTICLE MODAL SYSTEM
        function openArticleModal(id) {
            const post = posts.find(p => p.id === id);
            if (!post) return;

            document.getElementById('modalMeta').innerText = `${post.tag.toUpperCase()} // ${post.date}`;
            document.getElementById('modalTitle').innerText = post.title;
            document.getElementById('modalStats').innerHTML = `
                <span>${post.readTime}</span>
                <span>•</span>
                <span>By Atharva</span>
            `;
            document.getElementById('modalBody').innerHTML = post.content;

            document.getElementById('articleModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeArticleModal() {
            document.getElementById('articleModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // COMMAND PALETTE (⌘K)
        function toggleCommandMenu() {
            const modal = document.getElementById('commandModal');
            const isHidden = modal.classList.contains('hidden');
            
            if (isHidden) {
                modal.classList.remove('hidden');
                document.getElementById('commandInput').focus();
                searchArticles('');
            } else {
                modal.classList.add('hidden');
            }
        }

        function searchArticles(query) {
            const resultsContainer = document.getElementById('searchResults');
            resultsContainer.innerHTML = '';

            const q = query.toLowerCase();
            const filtered = posts.filter(p => p.title.toLowerCase().includes(q) || p.abstract.toLowerCase().includes(q) || p.tag.toLowerCase().includes(q));

            if (filtered.length === 0) {
                resultsContainer.innerHTML = `<div class="p-3 text-brand-500">No matching articles found.</div>`;
                return;
            }

            filtered.forEach(p => {
                const div = document.createElement('div');
                div.className = 'p-2.5 rounded hover:bg-brand-200/60 dark:hover:bg-brand-800 cursor-pointer text-brand-800 dark:text-brand-200 flex justify-between items-center';
                div.onclick = () => {
                    toggleCommandMenu();
                    openArticleModal(p.id);
                };
                div.innerHTML = `
                    <span class="truncate pr-2">${p.title}</span>
                    <span class="text-[10px] text-brand-500 uppercase flex-shrink-0">${p.tag}</span>
                `;
                resultsContainer.appendChild(div);
            });
        }

        // THEME MANAGEMENT (Dark / Light)
        function toggleTheme() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // INITIALIZE SAVED THEME
        function initTheme() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'light') {
                document.documentElement.classList.remove('dark');
            } else {
                document.documentElement.classList.add('dark');
            }
        }

        // GLOBAL SHORTCUTS
        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                toggleCommandMenu();
            }
            if (e.key === 'Escape') {
                closeArticleModal();
                document.getElementById('commandModal').classList.add('hidden');
            }
        });

        // INIT ON LOAD
        window.onload = function() {
            initTheme();
            lucide.createIcons();
            renderArticles('all');
        };
    </script>
